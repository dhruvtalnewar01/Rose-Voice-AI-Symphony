# Voice AI Configuration (Bolna & OpenAI)
NEXT_PUBLIC_VOICE_PROVIDER="bolna"

# Bolna AI Credentials (https://app.bolna.dev)
NEXT_PUBLIC_BOLNA_AGENT_ID="your_bolna_agent_id_here"
BOLNA_API_KEY="your_bolna_api_key_here"

# OpenAI API Credentials (https://platform.openai.com/api-keys)
OPENAI_API_KEY="your_openai_api_key_here"

# Free Public Clinical & Nutrition APIs (No API keys required)
OPENFDA_API_URL="https://api.fda.gov/drug/label.json"
RXNORM_API_URL="https://rxnav.nlm.nih.gov/REST/"
OPENFOODFACTS_API_URL="https://world.openfoodfacts.org/api/v2/"

# MediaPipe Hand Landmarker Model Path (Local or CDN)
NEXT_PUBLIC_HAND_LANDMARKER_MODEL_PATH="/models/hand_landmarker.task"
